all: all-am

.SUFFIXES:
.SUFFIXES: .S .c .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu uth/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu uth/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-uthlibLIBRARIES: $(uthlib_LIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(uthlib_LIBRARIES)'; test -n "$(uthlibdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(uthlibdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(uthlibdir)" || exit 1; \
	  echo " $(INSTALL_DATA) $$list2 '$(DESTDIR)$(uthlibdir)'"; \
	  $(INSTALL_DATA) $$list2 "$(DESTDIR)$(uthlibdir)" || exit $$?; }
	@$(POST_INSTALL)
	@list='$(uthlib_LIBRARIES)'; test -n "$(uthlibdir)" || list=; \
	for p in $$list; do \
	  if test -f $$p; then \
	    $(am__strip_dir) \
	    echo " ( cd '$(DESTDIR)$(uthlibdir)' && $(RANLIB) $$f )"; \
	    ( cd "$(DESTDIR)$(uthlibdir)" && $(RANLIB) $$f ) || exit $$?; \
	  else :; fi; \
	done

uninstall-uthlibLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(uthlib_LIBRARIES)'; test -n "$(uthlibdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(uthlibdir)'; $(am__uninstall_files_from_dir)

clean-uthlibLIBRARIES:
	-$(am__rm_f) $(uthlib_LIBRARIES)

libuth.a: $(libuth_a_OBJECTS) $(libuth_a_DEPENDENCIES) $(EXTRA_libuth_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libuth.a
	$(AM_V_AR)$(libuth_a_AR) libuth.a $(libuth_a_OBJECTS) $(libuth_a_LIBADD)
	$(AM_V_at)$(libuth_a_RANLIB) libuth.a

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/md.Po@am__quote@ # am--include-marker
