dnl Configure.in file for PSthreads/UthLib

AC_INIT(psthreads,1.0.4,,psthreads)
AC_CONFIG_AUX_DIR(build-aux)
AC_CANONICAL_SYSTEM

AM_CONFIG_HEADER(include/config.h)
AM_INIT_AUTOMAKE


AC_PROG_CC
AC_LANG_C
AC_PROG_MAKE_SET
AC_PROG_RANLIB
AM_PROG_AS
AC_C_INLINE


#=============================================================================
# Check operating system (for uth).
#=============================================================================
AC_MSG_CHECKING([operating system])
case "${host}" in
  *-ibm-aix4*     ) OS=AIX        ;;
  *-freebsd*      ) OS=FREEBSD    ;;
  hppa*-hp-hpux11*) OS=HPUX       ;;
  *-sgi-irix6*    ) OS=IRIX       ;;
  *-linux*        ) OS=LINUX      ;;
  *-netbsd*       ) OS=NETBSD     ;;
  *-openbsd*      ) OS=OPENBSD    ;;
  *-dec-osf*      ) OS=OSF1       ;;
  *-solaris2*     ) OS=SOLARIS    ;;
  *-darwin*       ) OS=DARWIN     ;;
  *-cygwin*       ) OS=CYGWIN     ;;
  *-mingw*        ) OS=MINGW      ;;
  *               ) OS=
                    echo "Sorry, unsupported OS"
                    exit 1        ;;
esac

AC_MSG_RESULT($OS)
AC_SUBST(OS)


#=============================================================================
# Adjust CPPFLAGS.
#=============================================================================
CPPFLAGS=${CPPFLAGS}' -D_REENTRANT  '

if test ".$OS" = ".IRIX"; then
	if test ".$GCC" = ".yes"; then
		CPPFLAGS=${CPPFLAGS}' -D__SGI_LIBC_NAMESPACE_QUALIFIER=  '
		AC_MSG_NOTICE([GNU gcc on IRIX, adjusting CPPFLAGS to ${CPPFLAGS}])
	fi
fi

AC_MSG_NOTICE([CPPFLAGS=${CPPFLAGS}])

#=============================================================================
# Figure out the system compiler
#=============================================================================
syscomp=""
# Intel
AC_CHECK_DECL(__INTEL_COMPILER, [ syscomp="intel" ])         
if eval "test x$syscomp = x"; then
# Sun Studio
  AC_CHECK_DECL(__SUNPRO_C, [ syscomp="sun" ])
  if eval "test x$syscomp = x"; then     
# MIPSpro
    AC_CHECK_DECL(_SGI_COMPILER_VERSION, [ syscomp="mipspro" ])
    if eval "test x$syscomp = x"; then
# GCC Cygwin
      AC_CHECK_DECL(__CYGWIN__, [ syscomp="cygwin" ])
      if eval "test x$syscomp = x"; then
# GCC
        AC_CHECK_DECL(__GNUC__, [ syscomp="gcc" ])                
      fi           
    fi
  fi
# Assume it is gcc after all
  if eval "test x$syscomp = x"; then
    echo "*** Cannot determine what the system compiler is!"
    echo "*** I am assuming it is a GNU compatible compiler."
    syscomp="gcc"
  fi
fi
echo ">> the system compiler is $syscomp"
AH_TEMPLATE(__SYSCOMPILER_intel, )
AH_TEMPLATE(__SYSCOMPILER_sun, )
AH_TEMPLATE(__SYSCOMPILER_mipspro, )
AH_TEMPLATE(__SYSCOMPILER_cygwin, )
AH_TEMPLATE(__SYSCOMPILER_gcc, )
AC_DEFINE_UNQUOTED( [__SYSCOMPILER_$syscomp ], [ 1 ],[ System compiler ])

#=============================================================================
# Check pthread.h
#=============================================================================
AC_CHECK_HEADERS(pthread.h)

#=============================================================================
# Setup ps_config.h
#=============================================================================
AH_TOP(
[
#ifndef _PS_CONFIG
#define _PS_CONFIG
])

AH_BOTTOM([#endif])

#=============================================================================
# Check if -lrt is needed for we sched_yield()
#=============================================================================
needRT=""
AC_CHECK_FUNCS(sched_yield, [ break ],     
	[ AC_CHECK_LIB(rt, sched_yield, [ needRT=yes ],
	[ AC_DEFINE_UNQUOTED(sched_yield(), 0, not found) ])
	])

if test ".$needRT" = ".yes"; then
	LDFLAGS="${LDFLAGS} -lrt"
fi

#=============================================================================
# Discover the stack growth direction (from GNU Pth).
#=============================================================================
AC_MSG_CHECKING([stack growth direction])
AC_RUN_IFELSE(
[[
#include <stdio.h>
#include <stdlib.h>

static int stack_grows_downward(int counter, char *baseptr) {
	if (counter < 100) {
		return stack_grows_downward(counter + 1, baseptr);
	} else {
		char tester;
		return ((baseptr - (&tester)) > 0);
	}
}

int main(int argc, char *argv[]) {
	FILE *fp;
	char basechar;

	if ((fp = fopen("conftestval", "w")) == NULL)
		exit(1);

	fprintf(fp, "%s\n", stack_grows_downward(0, &basechar) ? "down" : "up");
	fclose(fp);
	exit(0);
}
]],
ac_cv_check_stackgrowth=`cat conftestval`,
ac_cv_check_stackgrowth=down,
ac_cv_check_stackgrowth=down
)

AC_MSG_RESULT([$ac_cv_check_stackgrowth])
if test ".$ac_cv_check_stackgrowth" = ".down"; then
    val="-1"
else
    val="+1"
fi
AC_DEFINE_UNQUOTED(UTH_STACK_GROWS, $val, [define for stack growth])


#=============================================================================
# Set context switch method.
#=============================================================================
csmopt=""
AC_ARG_WITH(csm,
	AC_HELP_STRING([--with-csm=method], [context switch method (sjlj, mcsc)]),
	[
	case $withval in
		sjlj| mcsc ) csmopt=$withval ;;
		* ) AC_MSG_ERROR([invalid context switch method -- allowed: mcsc,sjlj]) ;;
	esac
	]
)

if test ".$csmopt" = "."; then
	AC_MSG_NOTICE([context switch method not defined - using default (sjlj)])
	csmopt=sjlj
fi

if test ".$csmopt" = ".sjlj"; then
	AC_CHECK_HEADERS(setjmp.h)

if test ".$OS" != ".MINGW"; then
	AC_CHECK_FUNCS([setjmp longjmp],,[missing_funcs="$missing funcs $ac_func"])
	if test -n "$missing_funcs"; then
		AC_MSG_FAILURE([cannot find required functions:$missing_funcs])
	fi
fi
	AC_DEFINE(UTH_CTXSW_SJLJ,,[Context management with jmpbuf])
elif test ".$csmopt" = ".mcsc"; then

if test ".$OS" != ".CYGWIN" && test ".$OS" != ".MINGW" ; then
	AC_CHECK_HEADERS(ucontext.h)
	AC_CHECK_FUNCS([makecontext swapcontext getcontext setcontext],,[missing_funcs="$missing funcs $ac_func"])
	if test -n "$missing_funcs"; then
		AC_MSG_FAILURE([cannot find required functions:$missing_funcs])
	fi
fi
	AC_DEFINE(UTH_CTXSW_MCSC,,[Context management with ucontext_t])
else
	AC_MSG_FAILURE([no appropriate context switch method found])
fi



#==============================================================================
# Enable assembly based sjlj
#==============================================================================
compile_md_s=""
case $OS in
	LINUX | CYGWIN | MINGW ) compile_md_s=yes ;;
	* ) ;;
esac

AM_CONDITIONAL(COMPILE_MD_S, test ".$compile_md_s" = ".yes")

USEASMSJLJ=""
AC_ARG_ENABLE(asmsjlj,
	AC_HELP_STRING([--enable-asmsjlj], [enable assembly based sjlj (default:disabled)]),
	if eval "test x$enable_asmsjlj = xyes"; then
		if test ".$compile_md_s" = ".yes"; then
			USEASMSJLJ="-DMD_USE_BUILTIN_SETJMP"
			AC_MSG_NOTICE([enabling assembly based setjmp/longjmp])
		else
			AC_MSG_NOTICE([bulting setjmp not available for this platform])
		fi
	fi,
	USEASMSJLJ="")

AC_SUBST(USEASMSJLJ)

#=============================================================================
# Check setjmp/longjmp
#=============================================================================
if test ".$csmopt" = ".sjlj"; then

AC_MSG_CHECKING([for usable setjmp/longjmp])
AC_RUN_IFELSE(
[[
	#include <stdio.h>
	#include <setjmp.h>

	static jmp_buf buf;
	int failure = 0;

	int main (int argc, char **argv) {
		FILE *fp;

		if ((fp = fopen("conftestval", "w")) == NULL)
			exit(1);
		fprintf(fp, "no\n");
		fclose(fp);
			
		switch (setjmp(buf)) {
		case 0: {
			longjmp(buf, 3);
			exit(1);	/* not reached */
			break;
			}
		case 3:
			if ((fp = fopen("conftestval", "w")) == NULL)
				exit(1);
			fprintf(fp, "yes\n");
			fclose(fp);
			exit(0);
			break;
			
		default: {
			failure = 2;
			exit(1);
			}
		}
		exit(0);
	}
]],
[check_sjlj=`cat conftestval`], [check_sjlj=no], [check_sjlj=no])

AC_MSG_RESULT([$check_sjlj])


if test ".$check_sjlj" = ".no"; then
	AC_MSG_FAILURE([setjmp/longjmp not usable])
fi

fi

#=============================================================================
# Check makecontext/swapcontext
#=============================================================================
win32_mcsc=""

if test ".$csmopt" = ".mcsc"; then

if test ".$OS" != ".CYGWIN" && test ".$OS" != ".MINGW" ; then

AC_MSG_CHECKING([for usable makecontext,swapcontext])
AC_RUN_IFELSE(
[[
#include <stdio.h>
#include <stdlib.h>
#include <ucontext.h>                 

ucontext_t uc_child;
ucontext_t uc_main;

void child(void *arg) {
	if (arg != (void *)12345)
		exit(1);
	if (swapcontext(&uc_child, &uc_main) != 0)
		exit(1);
}

int main(int argc, char *argv[]) {
	void *stack;   
	FILE *fp;
	
	if ((fp = fopen("conftestval", "w")) == NULL)
		exit(1);
	fprintf(fp, "no\n");
	fclose(fp);

	/* configure a child user-space context */
	if ((stack = malloc(64*1024)) == NULL)
		exit(1);
	if (getcontext(&uc_child) != 0)
		exit(1);
	uc_child.uc_link = NULL;
	uc_child.uc_stack.ss_sp = (char *)stack+(32*1024);
	uc_child.uc_stack.ss_size = 32*1024;
	uc_child.uc_stack.ss_flags = 0;
	makecontext(&uc_child, child, 2, (void *)12345);

	/* switch into the user context */
	if (swapcontext(&uc_main, &uc_child) != 0)
		exit(1);

	if ((fp = fopen("conftestval", "w")) == NULL)
		exit(1);
	fprintf(fp, "yes\n");
	fclose(fp);
	
	/* die successfully */
	exit(0);
}
]],
[check_mcsc=`cat conftestval`], [check_mcsc=no], [check_mcsc=no])

AC_MSG_RESULT([$check_mcsc])

if test ".$check_mcsc" = ".no"; then
	AC_MSG_FAILURE([makecontext/swapcontext not usable])
fi

else
	AC_MSG_NOTICE([using custom makecontext/swapcontext for Windows]) 
	win32_mcsc="yes"
fi 

fi


AM_CONDITIONAL(WIN32_MCSC, test ".$win32_mcsc" = ".yes")


#=============================================================================
# Check stack setup for ucontext (from GNU Pth)
#=============================================================================
if test ".$csmopt" = ".mcsc"; then

if test ".$OS" != ".CYGWIN" && test ".$OS" != ".MINGW" ; then

AC_MSG_CHECKING(for stack setup via makecontext)
AC_RUN_IFELSE(
[[
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ucontext.h> 
union alltypes {
	long   l;          
	double d;
	void  *vp;
	void (*fp)(void);
	char  *cp;
};
            
static volatile char *handler_addr = (char *)0xDEAD;

static ucontext_t uc_handler;                 
static ucontext_t uc_main;               
void handler(void)
{
	char garbage[1024];
	int i;
	auto int dummy;
	for (i = 0; i < 1024; i++)         
		garbage[i] = 'X';
	handler_addr = (char *)&dummy;  
	swapcontext(&uc_handler, &uc_main);
	return;
}           

int main(int argc, char *argv[])
{         
	FILE *fp;
	char *skaddr;
	char *skbuf;
	int sksize;
	char result[1024];
	int i;
	sksize = 32768;
	
	skbuf = (char *)malloc(sksize*2+2*sizeof(union alltypes));
	if (skbuf == NULL)
		exit(1);
	for (i = 0; i < sksize*2+2*sizeof(union alltypes); i++)
		skbuf[i] = 'A';
	skaddr = skbuf+sizeof(union alltypes);

	if (getcontext(&uc_handler) != 0)
		exit(1);
		
	uc_handler.uc_link = NULL;
	uc_handler.uc_stack.ss_sp    = (void *)(skaddr + sksize);
	uc_handler.uc_stack.ss_size  = sksize;
	uc_handler.uc_stack.ss_flags = 0;
	makecontext(&uc_handler, handler, 1);
	swapcontext(&uc_main, &uc_handler);


	if (handler_addr == (char *)0xDEAD)
		exit(1);
		
	if (handler_addr < skaddr+sksize) {
		/* stack was placed into lower area */
		if (*(skaddr+sksize) != 'A')
			sprintf(result, "(skaddr)+(sksize)-%d,(sksize)-%d",
				sizeof(union alltypes), sizeof(union alltypes));
		else
			strcpy(result, "(skaddr)+(sksize),(sksize)");
	}
	else {
		/* stack was placed into higher area */
		if (*(skaddr+sksize*2) != 'A')
			sprintf(result, "(skaddr),(sksize)-%d", sizeof(union alltypes));
		else
			strcpy(result, "(skaddr),(sksize)");
	}

	if ((fp = fopen("conftestval", "w")) == NULL)
		exit(1);
		
	fprintf(fp, "%s\n", result);
	fclose(fp);
	exit(0);
}
]],
[
dnl # test successully passed
ac_cv_stacksetup=`cat conftestval`
ac_cv_stacksetup="ok:$ac_cv_stacksetup"
],[
dnl # test failed
ac_cv_stacksetup='guessed:(skaddr),(sksize)'
],[
dnl # cross-platform => failed
ac_cv_stacksetup='guessed:(skaddr),(sksize)'
])

else

if test ".$OS" = ".CYGWIN"; then
ac_cv_stacksetup='CYGWIN:(skaddr),(sksize)'
fi

if test ".$OS" = ".MINGW"; then
ac_cv_stacksetup='MINGW:(skaddr),(sksize)'
fi


fi 

# extract result ingredients of single cached result value
type=`echo $ac_cv_stacksetup | sed -e 's;:.*$;;'`
addr=`echo $ac_cv_stacksetup | sed -e 's;^.*:;;' -e 's;,.*$;;'`
size=`echo $ac_cv_stacksetup | sed -e 's;^.*:;;' -e 's;^.*,;;'`

# export result ingredients

UTH_MCSC_SKADDR="'UTH_MCSC_SKADDR(skaddr,sksize)=$addr'"
UTH_MCSC_SKSIZE="'UTH_MCSC_SKSIZE(skaddr,sksize)=$size'"

# AC_SUBST(UTH_MCSC_SKADDR)
# AC_SUBST(UTH_MCSC_SKSIZE)

AC_DEFINE_UNQUOTED(UTH_MCSC_SKADDR(skaddr,sksize), $addr, [stack address for makecontext])
AC_DEFINE_UNQUOTED(UTH_MCSC_SKSIZE(skaddr,sksize), $size, [stack size for makecontext])

# display result indicator
AC_MSG_RESULT([$type])
# display results in detail
AC_MSG_RESULT($UTH_MCSC_SKADDR)
AC_MSG_RESULT($UTH_MCSC_SKSIZE)

fi

AM_CONDITIONAL(STACK_MCSC, test ".$csmopt" = ".mcsc")

#=============================================================================
# Set synchronization method
#=============================================================================
syncopt=""
mutexspin=""
AC_ARG_WITH(sync,
	AC_HELP_STRING([--with-sync=method], [posix synchronization mechanism (mutex, mutex_try, spin, spin_try)]),
	[
	case $withval in
		mutex| mutex_try )	syncopt=$withval 
					mutexspin="mutex" ;;
		spin | spin_try)	syncopt=$withval 
					mutexspin="spin" ;;
		* ) AC_MSG_ERROR([invalid synchronization mechanism -- allowed:mutex,mutex_try,spin,spin_try]) ;;
	esac
	]
)


if test ".$syncopt" = "."; then
	AC_MSG_NOTICE([posix synchronization method not defined - using default (mutex_try)])
	syncopt=mutex_try
	mutexspin=mutex
fi


if test ".$mutexspin" = ".mutex"; then
	# Check for mutex locks
	AC_MSG_CHECKING([for usable pthread_mutex_t])
	AC_COMPILE_IFELSE([AC_LANG_PROGRAM(
	[[	#include <pthread.h>
		pthread_mutex_t lock;
	]],
	[[	pthread_mutex_init(&lock,NULL); 
		pthread_mutex_lock(&lock);
		pthread_mutex_unlock(&lock); 
		pthread_mutex_trylock(&lock); 
	]])],,
	AC_MSG_FAILURE([pthread_mutex_t not available]))
	AC_MSG_RESULT([yes])

elif test ".$mutexspin" = ".spin"; then
	# Check for spin locks
	# Usually they are available with the _XOPEN_SOURCE macro
	AC_MSG_CHECKING([for usable pthread_spinlock_t])
	AC_COMPILE_IFELSE([AC_LANG_PROGRAM(
	[[
	#define _XOPEN_SOURCE 600
	
	#include <pthread.h>
	pthread_spinlock_t lock;
	]],
	[[
	pthread_spin_init(&lock,0); 
	pthread_spin_lock(&lock); 
	pthread_spin_unlock(&lock); 
	pthread_spin_trylock(&lock);
	]])],,
	AC_MSG_FAILURE([pthread_spinlock_t not available]))
	AC_MSG_RESULT([yes])
else
	AC_MSG_FAILURE([no appropriate synchronization method found])
fi

# 
# 

if test ".$syncopt" = ".mutex"; then
	(cd include; echo "#define POSIX_MUTEX_LOCK" > ps_config.h)
elif test ".$syncopt" = ".mutex_try"; then
	(cd include; echo "#define POSIX_MUTEX_TRYLOCK" > ps_config.h)
elif test ".$syncopt" = ".spin"; then
	(cd include; echo  "#define POSIX_SPIN_LOCK" > ps_config.h)
elif test ".$syncopt" = ".spin_try"; then
	(cd include; echo  "#define POSIX_SPIN_TRYLOCK" > ps_config.h)
else
	AC_MSG_FAILURE([no appropriate synchronization method found])
fi


#==============================================================================
# Set max number of virtual processors
#==============================================================================
NVPS="16"
AC_ARG_WITH(maxvps,
	AC_HELP_STRING([--with-maxvps=num], [maximum number of virtual processors (default:16)]),
	[
	NVPS=$withval
	]
)
AC_SUBST(NVPS)

#==============================================================================
# Enable emulation of user-level threads
#==============================================================================
emu_uth=""
AC_ARG_ENABLE(uth2pth,
	AC_HELP_STRING([--enable-uth2pth], [emulate user-level threads on top of POSIX threads (default:disabled)]),
	if eval "test x$enable_uth2pth = xyes"; then
		emu_uth="yes"
		AC_MSG_NOTICE([emulating user-level threads context switch method not applied])
	fi,
	emu_uth="")

AM_CONDITIONAL(PTH, test ".$emu_uth" = ".yes")

#==============================================================================
# Enable debugging
#==============================================================================
AC_ARG_ENABLE(debug,
	AC_HELP_STRING([--enable-debug], [enable debugging (default:disabled)]),
	if eval "test x$enable_debug = xyes"; then
		DEBUGFLAG="-g"
	else
		DEBUGFLAG=""
	fi,
	DEBUGFLAG="")

AC_SUBST(DEBUG_FLAG)

#==============================================================================
# Additional options
#==============================================================================
AC_ARG_ENABLE(handoff,
	AC_HELP_STRING([--enable-handoff], [enable handoff mechanism (default: disabled)]),
	if eval "test x$enable_handoff = xyes"; then
		AC_DEFINE(PS_P2P_HANDOFF,,[Enable handoff mechanism])
	fi,
	)


AC_ARG_ENABLE(lockfree,
	AC_HELP_STRING([--enable-lockfree], [enable lockfree lifo queues (default: disabled)]),
	if eval "test x$enable_lockfree = xyes"; then
		AC_DEFINE(PS_LOCK_FREE,,[Enable lock-free lifo queues])
	fi,
	)

#==============================================================================
# Enable 64-byte aligned stack
#==============================================================================
stack_alignment="page"
AC_ARG_ENABLE(stackalign64,
	AC_HELP_STRING([--enable-stackalign64], [enable 64-byte stack alignment (default:page alignment)]),
	if eval "test x$enable_stackalign64 = xyes"; then
		stack_alignment="64B"
	else
		stack_alignment="page"
	fi,
	stack_alignment="page")

if test ".$stack_alignment" = ".page"; then
	AC_DEFINE(UTH_PAGE_ALIGNED_STACK,,[page aligned stack, otherwise 64byte aligned])
fi

#==============================================================================
# Use mmap for memory stack allocation
#==============================================================================
stack_alloc="alloc"
AC_ARG_ENABLE(stackalloc,
	AC_HELP_STRING([--enable-mmap], [enable mmap-based memory stack allocation (default:malloc-based)]),
	if eval "test x$enable_stackalloc = xyes"; then
		stack_alloc="mmap"
	else
		stack_alloc="alloc"
	fi,
	stack_alloc="alloc")

if test ".$stack_alloc" = ".alloc"; then
	AC_DEFINE(UTH_MALLOC_STACK,,[malloc-based memory stack allocation])
fi

#==============================================================================
# Define self-identification method
# ==============================================================================
self_identification=""
AC_ARG_WITH(si,
	AC_HELP_STRING([--with-si=method], [self identification: vpid, tsd, stack (default:vpid)]),
	[
	case $withval in
		vpid )	AC_DEFINE(UTH_SI_VPID,,[Virtual-processor based self identification])
			AC_DEFINE(UTH_SI_KEEP_CURRENT_THREAD,,[Keep track of current underlying thread]) ;;
		tsd )	AC_DEFINE(UTH_SI_TSD,,[Thread-specific-data based self identification])
			self_identification="tsd" ;;
		stack )	AC_DEFINE(UTH_SI_SB,,[Stack based self identification])
			self_identification="stack" ;;
		* ) AC_MSG_FAILURE([invalid thread self identification mechanism -- allowed: vpid,tsd,stack]) ;;
	esac
	]
)

if test ".$self_identification" = "."; then
	AC_MSG_NOTICE([Using virtual processor id self identification])
	AC_DEFINE(UTH_SI_VPID,,[Virtual-processor based self identification])
	AC_DEFINE(UTH_SI_KEEP_CURRENT_THREAD,,[Keep track of current underlying thread])
fi

AC_ARG_ENABLE(keepcurrent,
	AC_HELP_STRING([--enable-keepcurrent], [keep track of current thread]),
	if eval "test x$enable_keepcurrent = xyes"; then
		AC_DEFINE(UTH_SI_KEEP_CURRENT_THREAD,,[Keep track of current underlying thread])
	fi,
	)

#==============================================================================
# Enable recycling of threads
# ==============================================================================
thread_recycling=""
AC_ARG_WITH(recycling,
	AC_HELP_STRING([--with-recycling=method], [recycling of threads: local, global, none (default:local)]),
	[
	thread_recycling="yes"
	case $withval in
		local )	AC_DEFINE(UTH_REUSE,,[Recycling of threads])
			AC_DEFINE(UTH_LOCAL_REUSE,,[Local recycling of threads]) ;;
		global) AC_DEFINE(UTH_REUSE,,[Recycling of threads]) ;;
		none)	;;
		* ) AC_MSG_FAILURE([invalid thread recycling mechanism -- allowed: local,global,none]) ;;
	esac
	]
)

if test ".$thread_recycling" = "."; then
	AC_MSG_NOTICE([Using local thread recycling by default])
	AC_DEFINE(UTH_REUSE,,[Recycling of threads])
	AC_DEFINE(UTH_LOCAL_REUSE,,[Local recycling of threads])
fi



#==============================================================================
# Fast barrier mechanism (psthread_barrier_wait_ex)
# ==============================================================================
barrier_mechanism=""
AC_ARG_WITH(barrier,
	AC_HELP_STRING([--with-barrier=method], [fast barrier mechanism: yield, queue (default:yield)]),
	[
	barrier_mechanism="yes"
	case $withval in
		yield) AC_DEFINE(PS_BAREX_YIELD,,[Yield-based fast barrier]) ;;
		queue) AC_DEFINE(PS_BAREX_QUEUE,,[Queue-based fast barrier]) ;;
		* ) AC_MSG_FAILURE([invalid fast barrier mechanism -- allowed: yield,queue]) ;;
	esac
	]
)

if test ".$barrier_mechanism" = "."; then
	AC_MSG_NOTICE([Using yield-based fast barrier mechanism by default])
	AC_DEFINE(PS_BAREX_YIELD,,[Yield-based fast barrier])
fi

#==============================================================================
# Enable stealing of threads
#==============================================================================
AC_ARG_ENABLE(stealing,
	AC_HELP_STRING([--enable-stealing], [enable thread stealing for psthreads (default:disabled)]),
	if eval "test x$enable_stealing = xyes"; then
		AC_DEFINE(PS_STEALING,,[thread stealing for psthreads])
	fi,
	)


#==============================================================================
# Enable single ready queue for dispatching
#==============================================================================
AC_ARG_ENABLE(singlequeue,
	AC_HELP_STRING([--enable-singlequeue], [enable single ready queue for thread dispatching (default:disabled)]),
	if eval "test x$enable_singlequeue = xyes"; then
		AC_DEFINE(PS_GLOBAL_QUEUE_ONLY,,[single ready queue for threads])
	fi,
	)

#=================================================================================
# Control yielding of idle virtual processors
#=================================================================================
yieldvp_flag=""

AC_ARG_ENABLE(yieldvp,
	AC_HELP_STRING([--disable-yieldvp], [disable yielding of idle virtual processors (default:enabled)]),
	if eval "test x$enable_yieldvp = xyes"; then
		yieldvp_flag="yes"
		AC_DEFINE(PS_YIELDVP,,[yielding of virtual processors])
	else
		yieldvp_flag="no"
	fi,
	)

if test ".$yieldvp_flag" = "."; then
	AC_DEFINE(PS_YIELDVP,,[yielding of virtual processors])
fi


#=============================================================================
# Check if we have all we need for explicit thread binding
#=============================================================================
LDFLAGS=-lpthread
AC_MSG_CHECKING([for pthread affinity])                
AC_LINK_IFELSE([AC_LANG_PROGRAM(
[[
   #define _GNU_SOURCE
   #include <pthread.h>
   #include <sched.h>]],      
[[ cpu_set_t cpuset; pthread_attr_t attr;
   if (sched_getcpu()) {
     CPU_ZERO(&cpuset);
     CPU_SET(1, &cpuset);          
   }            
   pthread_attr_init(&attr);
   pthread_setaffinity_np(pthread_self(), sizeof(cpuset), (const cpu_set_t *)&cpuset); ]])],
   AC_DEFINE_UNQUOTED(PTHREAD_AFFINITY, 1, [for pthread affinity])
   AC_MSG_RESULT([yes]),
   AC_MSG_RESULT([no])               
)      

#=============================================================================
# Check size of data types
#=============================================================================

AC_CHECK_SIZEOF(void *)
AC_CHECK_SIZEOF(long)
AC_CHECK_SIZEOF(int)
AC_CHECK_SIZEOF(pthread_t)

#=============================================================================
# Check default cache line size
#=============================================================================
defcls=""

AC_MSG_CHECKING([for default cache line size])
AC_RUN_IFELSE(
[[
/* Borrowed from OMPi (lib/sysdeps.h) */
#include <stdio.h>

/*
 * Processors
 */
#if defined(pentium4) || defined(__pentium4)
  #define __cpu_x86 686
#elif defined(i686) || defined(__i686) || \
    defined(pentiumpro) || defined(__pentiumpro) || \
    defined(pentium2) || defined(__pentium2) || \
    defined(pentium3) || defined(__pentium3)
  #define __cpu_x86 686
  #define __cpu_686_class p6       /* Only used for CACHE_LINE size */
#elif defined(i586) || defined(__i586) || defined(pentium) || defined(__pentium)
  #define __cpu_x86 586
#elif defined(i486) || defined(__i486)
  #define __cpu_x86 486
#elif defined(i386) || defined(__i386)
  #define __cpu_x86 386
#endif

#if defined(sparcv9) || defined(__sparcv9)
  #define __cpu_sparc v9
#elif defined(sparc) || defined(__sparc)
  #define __cpu_sparc v8
#endif

#if defined(mips) || defined(__mips)
  #define __cpu_mips 1
#endif

/*
 * CACHE_LINE size (for L2 cache).
 * A generally good value here is 128 bytes, so it is the default, to be
 * on the safe side.
 * However, different processors have different sizes, so below
 * we try to match their values.
 */
#if defined(__cpu_x86)
  /* Up to and including P6 cpus (Pentium Pro, Pentium II, Pentium III),
   * the L1 & L2 line size is 32 bytes. All newer CPUs have cache lines
   * of 64 bytes. Netbutst CPUs (Pentium 4, Pentium D, Pentium Extreme and
   * some Xeons), in addition have a "sector" size of 128 bytes.
   * #if __cpu_686_class == p6
   *   #define CACHE_LINE 32
   * #else
   *   #define CACHE_LINE 64
   * #endif
   * All known Athlons have 64-byte cache lines.
   */
  #define CACHE_LINE 64
#elif defined(__cpu_sparc)
  /* UltraSparcs (v9) use L2 cache lines of 64 bytes, up to IIIi.
   * IIIcu has line sizes 64 - 512 bytes (!) but anyways, they have
   * the 64 bytes as "a unit of fill & coherency".
   * IV ahs 64 - 128 bytes
   * IV+ and T1 came back to 64-byte cache lines.
   *
   * So, 64 bytes should be ok.
   */
  #define CACHE_LINE 64
#elif defined(__cpu_mips)
   /* The specifications say that the R4000 has a variable size for
    * its cache lines, between 4 and 32 words. MIPS 10000 (MIPS IV)
    * has 16-32 words lines, and it is a 64-bit CPU, which means
    * that it has lines of size 128-256 bytes.
    * The following may need to be modified to 256(?).
    */
  #define CACHE_LINE 128
#else
  #define CACHE_LINE 128       /* A default value */
#endif


int main(int argc, char *argv[]) {
	FILE *fp;
	
	if ((fp = fopen("conftestval", "w")) == NULL)
		exit(1);
	fprintf(fp, "%d\n", CACHE_LINE);
	fclose(fp);

	/* die successfully */
	exit(0);
}
]],
[defcls=`cat conftestval`], [defcls="128"], [defcls="128"])

AC_MSG_RESULT([$defcls])

#=============================================================================
# Set cache line size
#=============================================================================
clsize=""
AC_ARG_WITH(cachelinesize,
	AC_HELP_STRING([--with-cachelinesize=value], [cache line size]),
	[
		clsize=$withval
		AC_MSG_NOTICE([cache line size is set to $clsize])
	]
)

if test ".$clsize" = "."; then
	clsize=$defcls
	AC_MSG_NOTICE([using default cache line size ($clsize bytes) ])
fi

AC_DEFINE_UNQUOTED(CACHE_LINE_SIZE, $clsize, [explicit cache line size])


(cd include; echo "#define CACHE_LINE_SIZE $clsize" >> ps_config.h)

#=============================================================================
# Statistics
#=============================================================================
AC_ARG_ENABLE(uthstats,
	AC_HELP_STRING([--enable-uthstats], [enable runtime statistics in UthLib]),
	if eval "test x$enable_uthstats = xyes"; then
		AC_DEFINE(UTH_STATS,,[Enable runtime statistics in UthLib])
	fi,
	)


AC_ARG_ENABLE(psstats,
	AC_HELP_STRING([--enable-psstats], [enable runtime statistics in PSthreads]),
	if eval "test x$enable_psstats = xyes"; then
		AC_DEFINE(PS_STATS,,[Enable runtime statistics in PSthreads])
	fi,
	)


# {UTH}_DEFAULT_STACK_SIZE	/* not necessary, it is set dynamically */
# UTH_MALLOC_STACK		/* not necessary to use mmap */


#=============================================================================
# Create psthreads_cflags, psthreads_libs
#=============================================================================
instdir=""
if test ".$prefix" = ".NONE"; then
instdir="/usr/local"
else
instdir=$prefix
fi

if test ".$mutexspin" = ".spin"; then
(cd scripts; echo "echo -I${instdir}/include -D_REENTRANT -D_XOPEN_SOURCE=600" > psthreads_cflags; chmod +x psthreads_cflags)
else
(cd scripts; echo "echo -I${instdir}/include -D_REENTRANT" > psthreads_cflags; chmod +x psthreads_cflags)
fi
(cd scripts; echo "echo -L${instdir}/lib -lpsthread -luth -lpthread" > psthreads_libs; chmod +x psthreads_libs)


#=============================================================================
# Create Makefiles
#=============================================================================
AC_OUTPUT(Makefile uth/Makefile psthread/Makefile uth_tests/Makefile psthread_tests/Makefile scripts/Makefile)
